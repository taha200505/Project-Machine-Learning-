__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json

# Git
.git/
.gitignore
.gitattributes
.github/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Documentation
*.md
!README.md
docs/
screenshots/

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Testing
tests/
test_*.py
*_test.py

# Logs
*.log
logs/
*.log.*

# Temporary files
*.tmp
*.temp
tmp/
temp/

# OS
Thumbs.db
.DS_Store

# Backup files
*.bak
*.backup
*~

# Large files (if any)
*.tar.gz
*.zip
*.rar

# Development data (keep only production data)
# test_data.csv
# sample_data.csv